# NTIS-UI Production Environment Configuration
# Tenant: Sample Municipal Corporation
 
NODE_ENV=production
 
# API Configuration
RUNTIME_API_BASE_URL=https://assetapi.scipl.info.in/api
RUNTIME_API_VERSION=v1
# NEXT_PUBLIC_API_BASE_URL=https://localhost:7293/api
NEXT_PUBLIC_API_BASE_URL=https://assetapi.scipl.info.in/api
NEXT_PUBLIC_API_VERSION=v1
# Application Configuration
RUNTIME_APP_NAME=NTIS Platform
RUNTIME_APP_ENVIRONMENT=production
 
# Internationalization
RUNTIME_DEFAULT_LOCALE=en
RUNTIME_SUPPORTED_LOCALES=en,hi,mr
 
# Security Configuration
RUNTIME_ENABLE_ANALYTICS=false
RUNTIME_ENABLE_DEBUG=false
 
# Performance
RUNTIME_ENABLE_SW=true