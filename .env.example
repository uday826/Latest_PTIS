# PTIS Frontend API Integration Configuration
# Copy this file to .env or .env.local to configure environment variables.

# Base URL pointing to the backend property tax API
VITE_API_BASE_URL=http://localhost:5000/api

# Feature flag to switch between mock data and real backend requests
# Set VITE_USE_MOCK_API to 'false' once real backend endpoints are ready for testing
VITE_USE_MOCK_API=true
